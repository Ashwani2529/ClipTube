# ClipTube — backend environment
# Copy to `.env` and replace the values. Every variable the backend reads is listed
# here; each one has the fallback shown below, so the server also runs with no .env at
# all. Read in src/config/env.ts.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Port the API listens on.
PORT=4000

# Origins allowed to call the API, comma-separated. Must include the frontend's URL.
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# MongoDB connection string. Local mongod, or an Atlas SRV URI.
MONGO_URI=mongodb://127.0.0.1:27017/cliptube

# ---------------------------------------------------------------------------
# Clip storage
# ---------------------------------------------------------------------------

# Where finished clips are written while waiting to be downloaded.
# Relative paths resolve against the backend folder; absolute paths are used as-is.
TEMP_DIR=temp

# Age in minutes at which an undownloaded clip is treated as orphaned and deleted.
TEMP_FILE_TTL_MINUTES=60

# Cron expression for the cleanup sweep. It also runs once at startup.
# Default is hourly, on the hour.
CLEANUP_CRON=0 * * * *

# Longest clip the API will build, in seconds. Guards against whole-video downloads.
MAX_CLIP_SECONDS=1800
