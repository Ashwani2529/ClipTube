# --- Server ---
PORT=4000

# Comma-separated list of origins allowed to call the API (the Vite dev server).
CORS_ORIGIN=http://localhost:5173

# --- Database ---
MONGO_URI=mongodb://127.0.0.1:27017/cliptube

# --- Clipping / files ---
# Directory (relative to the backend folder, or absolute) where clips are written.
TEMP_DIR=temp

# Orphaned files older than this are deleted by the cleanup job.
TEMP_FILE_TTL_MINUTES=60

# How often the cleanup job runs (it also runs once at startup).
CLEANUP_CRON=0 * * * *

# Hard cap on clip length, in seconds (guards against whole-video downloads).
MAX_CLIP_SECONDS=1800

# --- Binaries (optional) ---
# Leave blank to auto-detect: system PATH first, then the npm-bundled binaries
# (youtube-dl-exec / ffmpeg-static / ffprobe-static).
YTDLP_PATH=
FFMPEG_PATH=
FFPROBE_PATH=
