# ClipTube — backend environment
# Copy to `.env` and replace the values. Every variable the backend reads is listed here
# with the fallback the code uses, so the server also starts with no .env at all.
# Read in src/config/env.ts.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Port the API listens on.
PORT=4000

# Origins allowed to call the API, comma-separated. Must include the frontend's URL.
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# MongoDB connection string — local mongod, or an Atlas SRV URI.
MONGO_URI=mongodb://127.0.0.1:27017/cliptube

# ---------------------------------------------------------------------------
# Clip storage
# ---------------------------------------------------------------------------

# Where finished clips are written while waiting to be downloaded. A relative path
# resolves against the backend folder; an absolute path is used as-is.
TEMP_DIR=temp

# Age in minutes at which an undownloaded clip is treated as orphaned and deleted.
TEMP_FILE_TTL_MINUTES=60

# Cron expression for the cleanup sweep, which also runs once at startup.
CLEANUP_CRON=0 * * * *

# Longest clip the API will build, in seconds. Guards against whole-video downloads.
MAX_CLIP_SECONDS=1800

# ---------------------------------------------------------------------------
# Cut accuracy
# ---------------------------------------------------------------------------

# false — fast keyframe-aligned cuts (default). No re-encode, so the clip can start up to
#         a keyframe early. This is what established yt-dlp front-ends do.
# true  — cut exactly at the requested timestamps (`--force-keyframes-at-cuts`). Accurate,
#         but it re-encodes the section: slow, memory-hungry, and a frequent cause of
#         ffmpeg crashing. The API falls back automatically if that happens.
YTDLP_FORCE_KEYFRAMES=false

# ---------------------------------------------------------------------------
# YouTube bot checks
# ---------------------------------------------------------------------------
# YouTube rejects datacenter IPs far more often than home connections, with
# "Sign in to confirm you're not a bot". Cookies are the reliable fix; everything else
# here is a mitigation.

# Netscape-format cookie file exported from a browser **while signed in to YouTube**.
# Passed as `--cookies`. At startup the server copies it somewhere writable (yt-dlp writes
# the refreshed jar back, and secret mounts like Render's /etc/secrets are read-only) and
# logs whether the file actually contains signed-in session cookies.
#
# Export it from a private/incognito window, then close that window without browsing
# YouTube again — YouTube rotates cookies and invalidates whatever you exported.
YTDLP_COOKIES_FILE=

# Player clients to try, in order. Each is sent as
# `--extractor-args youtube:player_client=<name>`, and a bot-checked request advances to
# the next one automatically. `default` means "let yt-dlp pick" and is a good first entry:
# yt-dlp tunes its own client set per release, so pinning one client is usually worse.
# Note that `tv` interacts badly with --cookies; prefer mweb/web_safari when signed in.
YTDLP_PLAYER_CLIENTS=default,mweb,web_safari,tv_simply,android_vr

# Raw value for `--extractor-args`, for full manual control.
# LEAVE BLANK to use the rotation above — setting this pins one client and disables it.
YTDLP_EXTRACTOR_ARGS=

# A single fixed proxy, passed as `--proxy`. Setting this disables the rotation below.
# Example: http://user:pass@host:port
YTDLP_PROXY=

# Random delay between requests, in seconds (`--sleep-interval`/`--max-sleep-interval`).
# 0 disables it. Only worth setting if you are being rate-limited — it slows everything.
YTDLP_SLEEP_INTERVAL=0
YTDLP_MAX_SLEEP_INTERVAL=0

# ---------------------------------------------------------------------------
# Automatic proxy rotation
# ---------------------------------------------------------------------------
# When true, the server pulls proxies from the providers below, keeps only the ones that
# can actually read a video from YouTube, and rotates to the next whenever a request comes
# back blocked. Ignored when YTDLP_PROXY is set.
#
# Providers are tried in order. The first two issue a fresh username/password with each
# fetch, so credentials are obtained at runtime rather than configured; the third is a
# large list of credential-free public proxies, used only if the first two come up empty.
# A provider that is down or has changed its response shape is skipped with a warning.
#
# Free proxies are slow and short-lived. Cookies remain the more reliable fix.
YTDLP_AUTO_PROXY=false

YTDLP_PROXY_ONWORKS_URL=https://www.onworks.net/vpn.json?v=07
YTDLP_PROXY_SANDVPN_URL=https://api.sandvpn.com/fetch-free-proxys
YTDLP_PROXY_LIST_URL=https://raw.githubusercontent.com/proxifly/free-proxy-list/main/proxies/all/data.json

# Video used to prove a proxy reaches YouTube unblocked.
YTDLP_PROXY_TEST_URL=https://www.youtube.com/watch?v=jNQXAC9IVRw

# How many validated proxies to keep in the rotation.
YTDLP_PROXY_POOL_SIZE=5

# Comma-separated country codes to skip.
YTDLP_PROXY_BLOCKED_COUNTRIES=CN,KP,IR,TM,ER,SY,RU
