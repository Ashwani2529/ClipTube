# ClipTube — backend environment
# Copy to `.env` and replace the values. Every variable the backend reads is listed here,
# each with the fallback the code uses, so the server also starts with no .env at all.
# Read in src/config/env.ts.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Port the API listens on.
PORT=4000

# Origins allowed to call the API, comma-separated. Must include the frontend's URL.
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# MongoDB connection string — local mongod, or an Atlas SRV URI.
MONGO_URI=mongodb://127.0.0.1:27017/cliptube

# ---------------------------------------------------------------------------
# Clip storage
# ---------------------------------------------------------------------------

# Where finished clips are written while waiting to be downloaded. A relative path
# resolves against the backend folder; an absolute path is used as-is.
TEMP_DIR=temp

# Age in minutes at which an undownloaded clip is treated as orphaned and deleted.
TEMP_FILE_TTL_MINUTES=60

# Cron expression for the cleanup sweep, which also runs once at startup.
# Default is hourly, on the hour.
CLEANUP_CRON=0 * * * *

# Longest clip the API will build, in seconds. Guards against whole-video downloads.
MAX_CLIP_SECONDS=1800

# ---------------------------------------------------------------------------
# yt-dlp / YouTube bot checks (all optional — blank means the flag is not passed)
# ---------------------------------------------------------------------------
# YouTube rejects datacenter IPs far more often than home connections, with
# "Sign in to confirm you're not a bot". These are the levers that get past it: usually
# unnecessary locally, usually necessary once deployed.

# Netscape-format cookie file exported from a signed-in browser. Passed as `--cookies`.
# The most reliable fix. Keep this file out of the repo and off public storage.
# yt-dlp writes the refreshed cookie jar back to this file, so the server copies it to a
# writable location at startup — a read-only secret mount (e.g. Render's /etc/secrets)
# works fine. If the file is unreadable, the server logs a warning and runs without it.
YTDLP_COOKIES_FILE=/etc/secrets/cookies.txt

# Proxy for every yt-dlp request, passed as `--proxy`. A residential proxy also clears
# the bot check. Example: http://user:pass@host:port
YTDLP_PROXY=

# Raw value for `--extractor-args`. Switching the player client sometimes avoids the
# check without cookies. Example: youtube:player_client=tv,web_safari
YTDLP_EXTRACTOR_ARGS=youtube:player_client=tv,web_safari

# ---------------------------------------------------------------------------
# Cut accuracy
# ---------------------------------------------------------------------------

# true  — cut exactly at the requested timestamps (`--force-keyframes-at-cuts`).
#         Accurate, but re-encodes the section: slow and memory-hungry, and on small
#         instances the helper ffmpeg can be killed mid-run. The API automatically
#         retries with a keyframe-aligned cut if that happens.
# false — always use fast keyframe-aligned cuts. No re-encode, so the clip can start up
#         to a keyframe early. Recommended on free/shared hosting.
YTDLP_FORCE_KEYFRAMES=false
