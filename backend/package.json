{
  "name": "cliptube-backend",
  "version": "1.0.0",
  "private": true,
  "description": "ClipTube API — yt-dlp + ffmpeg powered YouTube clip service",
  "main": "dist/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "install:binaries": "npm install ffmpeg-static ffprobe-static youtube-dl-exec"
  },
  "keywords": [
    "youtube",
    "yt-dlp",
    "ffmpeg",
    "clip"
  ],
  "author": "Ashwani Singh",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "fluent-ffmpeg": "^2.1.3",
    "mongoose": "^9.9.3",
    "node-cron": "^4.6.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
