# ClipTube — frontend environment
# Copy to `.env` and replace the value. Vite only exposes variables prefixed with `VITE_`
# to client code. Read in src/lib/api.ts.

# Base URL the app prefixes onto every API call.
#
# Leave blank in development: the Vite dev server proxies `/api` to the backend
# (see vite.config.ts), which keeps requests same-origin so file downloads work without
# any CORS handling. The code falls back to `/api` when this is unset.
#
# Set it for a production build where the API is on another host, e.g.
# VITE_API_BASE_URL=https://cliptube-ny8q.onrender.com/api
VITE_API_BASE_URL=
